{
  "lastChangelogVersion": "1.0.0",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "theme": "dark",
  "hideThinkingBlock": true,
  "quietStartup": false,
  "outputPad": 1,
  "steeringMode": "all",
  "followUpMode": "all",
  "collapseChangelog": true,
  "httpIdleTimeoutMs": 120000,
  "markdown": {
    "codeBlockIndent": "",
    "mermaid": "final"
  },
  "defaultTools": [
    "read",
    "bash",
    "edit",
    "write",
    "grep",
    "find",
    "+codemode"
  ],
  "packages": [
    "npm:pi-web-access",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-background-tasks",
    "npm:pi-zentui",
    "npm:@narumitw/pi-btw",
    "https://github.com/ayghri/i-have-adhd",
    "npm:@ff-labs/pi-fff",
    "npm:pi-context",
    "npm:pi-matt-pocock",
    "git:github.com/DietrichGebert/ponytail",
    "git:github.com/geniusgordon/pi-herdr-crew"
  ],
  "tuiMode": "fullscreen",
  "treeFilterMode": "user-only",
  "warnings": {
    "anthropicExtraUsage": true
  },
  "terminal": {
    "showTerminalProgress": true
  },
  "editorPaddingX": 0,
  "compaction": {
    "enabled": true
  }
}
